# Local development credentials only. Set a unique password before deployment.
POSTGRES_USER=bag
POSTGRES_PASSWORD=bag-local-dev
POSTGRES_DB=bag
# Host port; Compose-internal database connections always use 5432.
BAG_POSTGRES_PORT=5432
# Host tools use this URL; adjust its port if BAG_POSTGRES_PORT changes.
# Compose uses postgres:5432 internally regardless of the host port.
BAG_DATABASE_URL=postgresql://bag:bag-local-dev@127.0.0.1:5432/bag
# API listens only on localhost by default. Use a TLS reverse proxy for remote access.
BAG_API_PORT=8000
# Name used by the initial, single-user bootstrap.
BAG_USER_NAME=My Bag
# Maximum JSON request size in bytes (includes note and metadata).
BAG_MAX_REQUEST_BYTES=1048576
# Maximum original file size, excluding multipart metadata (default 50 MiB).
BAG_MAX_UPLOAD_BYTES=52428800
# Host storage directory; Compose uses the bag-storage volume at /data/storage.
BAG_STORAGE_PATH=./data/storage
# Worker health/readiness server port.
BAG_WORKER_PORT=8001
# Idle polling interval of the job loop in seconds.
BAG_WORKER_POLL_SECONDS=1.0
# A claimed job may run this long before another worker may take it over.
BAG_JOB_LEASE_SECONDS=300
# Attempts per processor and item before the run is marked failed.
BAG_JOB_MAX_ATTEMPTS=5
# Base delay before the first retry; doubles per attempt, capped at one hour.
BAG_JOB_RETRY_SECONDS=5.0
# Days a trashed item stays restorable before `bag purge` removes it.
BAG_TRASH_RETENTION_DAYS=30
# The worker fetches saved URLs to store a page snapshot and searchable text.
# What leaves the server: a GET request with the saved URL to that URL's own host
# (User-Agent BagOfHolding). Private, loopback and link-local destinations are
# never contacted. Set to false to keep the worker fully offline.
BAG_FETCH_URLS=true
BAG_FETCH_MAX_BYTES=5242880
BAG_FETCH_TIMEOUT_SECONDS=10
BAG_FETCH_MAX_REDIRECTS=5
# Tests require a SEPARATE disposable database, never the application database.
# BAG_TEST_DATABASE_URL=postgresql://bag:bag-local-dev@127.0.0.1:5432/bag_test
